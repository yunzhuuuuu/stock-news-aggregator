# Copy this file to .env.local after creating a Supabase project.
# These two values are safe to use in browser code because database access is
# protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Stage C/D values. Never add NEXT_PUBLIC_ to these names, commit
# real secrets, or expose them in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# Used for protected manual/local price refresh requests.
PRICE_REFRESH_SECRET=generate-a-long-random-secret
MARKETAUX_API_TOKEN=your-marketaux-api-token

# Vercel automatically sends this value as a Bearer token to scheduled routes.
# Use a different long random value from PRICE_REFRESH_SECRET.
CRON_SECRET=generate-a-different-long-random-secret
